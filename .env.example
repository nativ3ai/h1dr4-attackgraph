# Local Sibyl database. Keep this outside version control.
ATTACKGRAPH_DB_PATH=.attackgraph/sibyl.db
ATTACKGRAPH_CONTROL_DB_PATH=.attackgraph/control.db
ATTACKGRAPH_OPERATOR_ID=demo-operator

# Passkeys are offered but skippable in local mode. Use "passkey" to require them.
ATTACKGRAPH_AUTH_MODE=optional
ATTACKGRAPH_RP_ID=localhost
ATTACKGRAPH_ORIGIN=http://localhost:3000

# MCP clients created by the dashboard receive their own revocable value.
# ATTACKGRAPH_AGENT_TOKEN=atk_agent_...

# Optional H3RETIK execution gate. Quoting and planning do not require these.
# ATTACKGRAPH_EXECUTION_APPROVAL_CODE=replace-with-a-human-generated-one-time-code
# ATTACKGRAPH_H3RETIK_ATTESTATION_TOKEN=separate-adapter-only-secret
# H3RETIK_WALLET=0x...
# H3RETIK_TOKEN=...
# H3RETIK_SESSION_ID=...
